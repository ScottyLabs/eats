{
  "name": "@cmueats/api",
  "version": "2.4.0",
  "description": "CMU Eats Dining API",
  "main": "src/main.ts",
  "scripts": {
    "dev": "deno run -A --watch src/main.ts",
    "build": "deno compile --frozen --no-check -A --cached-only --node-modules-dir=none --exclude-unused-npm --include drizzle --output dist/bin/dining-api src/main.ts",
    "start": "deno run -A src/main.ts",
    "test": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest --coverage",
    "typecheck": "tsc",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check-migrations": "drizzle-kit check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://git.cmu.dev/ScottyLabs/eats.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://git.cmu.dev/ScottyLabs/eats/issues"
  },
  "homepage": "https://git.cmu.dev/ScottyLabs/eats",
  "dependencies": {
    "@elysia/static": "^1.4.11",
    "@elysiajs/cors": "1.3.3",
    "@elysiajs/node": "1.4.2",
    "@elysiajs/openapi": "^1.4.11",
    "@types/express": "^5.0.3",
    "axios": "^1.10.0",
    "cheerio": "1.0.0-rc.12",
    "cookie-signature": "^1.2.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "elysia": "1.4.30",
    "exact-mirror": "0.2.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^8.0.1",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "srvx": "^1.0.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@types/cookie-signature": "^1.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.14",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.0",
    "dotenv-cli": "^8.0.0",
    "npm-check-updates": "^18.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
