{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/*.json",
    "**/*.rc",
    "**/*.config.ts",
    "**/*.node.json",
    "**/.eslint*",
    ".vscode/*",
    "**/.settings.json",
    "**/.gitignore",
    "**/.gitattributes",
    "**/node_modules/*",
    "**/build/*",
    "**/dist/*",
    "**/tests/*",
    "**/api.d.ts"
  ],
  "plugins": ["typescript", "import"],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es6": true,
    "es2026": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn"] }],
    "typescript/no-use-before-define": [
      "error",
      { "functions": false, "classes": false }
    ],
    "no-plusplus": "off",
    "no-nested-ternary": "off",
    "import/no-named-as-default": "off",
    "import/no-unassigned-import": "off",
    "no-unsafe-type-assertion": "off",
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none"
      }
    ]
  }
}
